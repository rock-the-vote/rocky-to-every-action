# Copy this file to .env for local testing only.
# NEVER commit .env — it contains real credentials.
# In production (GitHub Actions) these are stored as GitHub Secrets.

# ── Rocky ────────────────────────────────────────────────────────────────────
# Reach out to Rock the Vote if you need help finding these.
ROCKY_PARTNER_ID=your_rocky_partner_id
ROCKY_API_KEY=your_rocky_api_key

# ── Every Action ─────────────────────────────────────────────────────────────
# EA_API_KEY:    Administrative Menu → Integrations → API Integrations → Request an API Key
# EA_LOGIN_NAME: the login name associated with your API key (provided by EA when approved)
# EA_DATABASE:   almost always EveryAction — options: EveryAction | MyCampaign | MyMembers | MyVoters
EA_API_KEY=your_everyaction_api_key
EA_LOGIN_NAME=your_everyaction_login_name
EA_DATABASE=EveryAction

# ── Notes ─────────────────────────────────────────────────────────────────────
# EA_DB_MODE and EA_URL are not needed here:
#   EA_DB_MODE 1 is handled automatically when EA_DATABASE=EveryAction
#   EA_URL (https://api.securevan.com/v4) is Parsons' built-in default
